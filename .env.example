# Copiá este archivo a `.env` para desarrollo local.
# Los valores por omisión sirven con `./scripts/up.sh`.

# Base de datos
POSTGRES_USER=liveagents
POSTGRES_PASSWORD=liveagents
POSTGRES_DB=liveagents
POSTGRES_PORT=5432
DATABASE_URL=postgres://liveagents:liveagents@db:5432/liveagents?sslmode=disable

# Entorno
APP_ENV=development
